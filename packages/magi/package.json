    "./plugin-installer": "./src/plugin-installer.ts",
    "./router": "./src/router.ts",
    "./runner": "./src/runner.ts",
    "./safety": "./src/safety.ts",
    "./state": "./src/state.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
