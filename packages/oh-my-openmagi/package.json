{
  "name": "oh-my-magi",
  "version": "0.2.1",
  "description": "Persistent three-member council and continuous improvement over the official OmO workforce.",
  "type": "module",
  "license": "MIT",
  "author": "eljja",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js"
  },
  "bin": {
    "oh-my-magi": "./dist/cli.js",
    "omm": "./dist/cli.js",
    "oh-my-openmagi": "./dist/cli.js"
  },
  "engines": {
    "bun": ">=1.3.13",
    "opencode": ">=1.18.29 <2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eljja/Magi.git",
    "directory": "packages/oh-my-openmagi"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "licenses",
    "compatibility.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun script/build.ts",
    "typecheck": "tsgo --noEmit",
    "test": "bun test ./test --timeout 30000",
    "smoke": "bun script/smoke.ts",
    "prepack": "bun run build",
    "pack:check": "bun script/pack-check.ts",
    "verify": "bun script/verify.ts",
    "soak": "bun script/soak.ts",
    "release:check": "bun script/release-check.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@opencode-ai/sdk": "1.18.31",
    "oh-my-opencode": "4.19.4",
    "jsonc-parser": "3.3.1",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
